rules_version = '2';

/* ═══════════════════════════════════════════════════════════
   Reglas de seguridad de Firestore — Drakón

   PUNTO CLAVE (requisito de suscripción real, no simulada):
   `isPremium` y `premiumExpiresAt` en users/{uid} SOLO pueden cambiar
   cuando la escritura NO incluye esos campos modificados por el cliente.
   La Cloud Function `verifyPlayPurchase` (functions/index.js) usa el SDK
   de administrador (firebase-admin), que se salta por completo estas
   reglas — así que ella SÍ puede escribir esos campos con normalidad; el
   cliente (con su token de usuario normal) NUNCA puede, aunque intente
   escribir directamente vía el SDK de Firestore sin pasar por la app.

   Desplegar con:
     firebase deploy --only firestore:rules
   ═══════════════════════════════════════════════════════════ */

service cloud.firestore {
  match /databases/{database}/documents {

    // Campos de edad: el servidor (functions/index.js) se fía de ellos, así que el
    // cliente no puede (a) darse a sí mismo parentalConsentStatus='approved', ni
    // (b) cambiar su año de nacimiento una vez fijado, ni (c) guardar un año inválido.
    function ageFieldsOk(){
      return request.resource.data.get('birthYear', null) == null
             || (request.resource.data.birthYear is int
                 && request.resource.data.birthYear >= 1900
                 && request.resource.data.birthYear <= 2100);
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
                    && !('isPremium' in request.resource.data)
                    && !('premiumExpiresAt' in request.resource.data)
                    && ageFieldsOk()
                    && request.resource.data.get('parentalConsentStatus', null) != 'approved';

      allow update: if request.auth != null && request.auth.uid == uid
                    // El cliente puede actualizar cualquier otro campo de su
                    // propio progreso, pero NUNCA estos dos — si intenta
                    // tocarlos (aunque sea con el mismo valor que ya tenían),
                    // la escritura se rechaza entera.
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['isPremium', 'premiumExpiresAt'])
                    && ageFieldsOk()
                    // 'approved' solo puede venir del servidor (SDK de administrador)
                    && (request.resource.data.get('parentalConsentStatus', null)
                          == resource.data.get('parentalConsentStatus', null)
                        || request.resource.data.get('parentalConsentStatus', null) != 'approved')
                    // el año de nacimiento no se puede cambiar una vez fijado
                    && (resource.data.get('birthYear', null) == null
                        || request.resource.data.get('birthYear', null) == resource.data.get('birthYear', null));

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Contadores internos de límites de uso del gateway de IA gestionado
    // (ver functions/index.js → consumeQuota) — de solo lectura para el
    // cliente (para mostrar "te quedan X mensajes hoy" si se desea), nunca
    // escribibles por él: solo la Cloud Function los actualiza.
    match /aiRateLimits/{docId} {
      allow read: if request.auth != null && docId.matches(request.auth.uid + '_.*');
      allow write: if false;
    }

    // Solicitudes de consentimiento parental (COPPA / Google Play Families).
    // El menor solo puede CREAR su propia solicitud, siempre en estado
    // 'pending' y con su propio uid como childUid — nunca puede aprobarla
    // él mismo ni modificarla después. Solo el SDK de administrador (usado
    // manualmente desde la consola de Firebase, o por una futura Cloud
    // Function de aprobación) puede cambiar el status a 'approved'.
    match /parentalConsentRequests/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.childUid == uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // Reportes de respuestas de la IA (política de contenido generado por IA de Google Play).
    // Cualquier persona con sesión puede CREAR un reporte; nadie puede leerlo, cambiarlo ni
    // borrarlo desde la app (se revisan desde la consola de Firebase). El documento NO lleva
    // uid ni correo: solo motivo, texto de la respuesta reportada y datos técnicos mínimos.
    match /aiReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['reason','text','note','lang','mode','createdAt'])
        && request.resource.data.keys().hasAll(['reason','text','createdAt'])
        && request.resource.data.reason in ['ofensiva','sexual','peligrosa','incorrecta','otra']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1500
        && request.resource.data.createdAt is int
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 300))
        && (!('lang' in request.resource.data) || (request.resource.data.lang is string && request.resource.data.lang.size() <= 8))
        && (!('mode' in request.resource.data) || (request.resource.data.mode is string && request.resource.data.mode.size() <= 24));
      allow read, update, delete: if false;
    }

    // Todo lo demás, denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
